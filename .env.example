# =============================================================================
# AutoRAG Repair Assistant - Environment Variables
# Copy to `.env` and adjust. NEVER commit `.env` (contains secrets).
# Variables use nested naming: <SECTION>__<FIELD>.
# =============================================================================

# --- Application -----------------------------------------------------------
APP__NAME=AutoRAG Repair Assistant
APP__VERSION=0.1.0
APP__ENVIRONMENT=development
APP__DEBUG=false

# --- Paths (relative to the project root by default) ------------------------
PATHS__PROJECT_ROOT=
PATHS__DATA_DIR=data
PATHS__DOCUMENTS_DIR=data/documents
PATHS__DB_DIR=data/db
PATHS__LOGS_DIR=data/logs

# --- SQLite ----------------------------------------------------------------
# Full path override. If empty, uses <DB_DIR>/<filename>.
DATABASE__PATH=
DATABASE__FILENAME=auto_rag.db

# --- Vector store (chroma | qdrant) -----------------------------------------
VECTORSTORE__BACKEND=chroma
# Full path override for Chroma persistence. If empty, uses <DB_DIR>/chroma.
VECTORSTORE__PERSIST_DIR=
VECTORSTORE__COLLECTION_NAME=auto_rag_documents
VECTORSTORE__DISTANCE=cosine

# --- Embeddings (HuggingFace sentence-transformers) -------------------------
EMBEDDINGS__MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDINGS__DIMENSION=384
EMBEDDINGS__DEVICE=auto
EMBEDDINGS__BATCH_SIZE=32
EMBEDDINGS__NORMALIZE=true
# Persist embeddings keyed by text hash (speeds up re-indexing). Off by default.
EMBEDDINGS__CACHE_ENABLED=false
EMBEDDINGS__CACHE_FILE=embedding_cache.json

# --- LLM (Ollama) ------------------------------------------------------------
LLM__PROVIDER=ollama
LLM__BASE_URL=http://localhost:11434
LLM__MODEL=llama3.1
LLM__TEMPERATURE=0.1
LLM__MAX_TOKENS=2048
LLM__TIMEOUT_SECONDS=120
LLM__TOP_P=0.95

# --- Retrieval ---------------------------------------------------------------
RETRIEVAL__TOP_K=5
RETRIEVAL__HYBRID_SEARCH=true
RETRIEVAL__HYBRID_TOP_K=8
RETRIEVAL__MMR=true
RETRIEVAL__MMR_LAMBDA_MULT=0.7
RETRIEVAL__MMR_FETCH_K=20
RETRIEVAL__RERANK=true
RETRIEVAL__RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL__RERANK_TOP_K=3

# --- Chunking ---------------------------------------------------------------
CHUNKING__SIZE=800
CHUNKING__OVERLAP=160

# --- Logging -----------------------------------------------------------------
# In production set JSON_FORMAT=true for structured logs and CONSOLE=false
# when a log shipper tails the file instead.
LOGGING__LEVEL=INFO
LOGGING__JSON_FORMAT=false
LOGGING__CONSOLE=true
LOGGING__FILE=true
LOGGING__FILE_MAX_BYTES=5242880
LOGGING__FILE_BACKUP_COUNT=3

# --- Health probes -----------------------------------------------------------
# The HTTP health server (auto-rag-health --serve) binds these by default.
HEALTH__HOST=0.0.0.0
HEALTH__PORT=8080
